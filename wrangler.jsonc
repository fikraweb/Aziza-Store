{
  "name": "aziza-store",
  "main": "worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "StoreData" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreData"] }]
}
